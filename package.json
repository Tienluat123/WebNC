{
"name": "ai-travel-planner",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
